#!/usr/bin/env python3
"""
hdmi-usb-screenshot-mcp — MCP server on stdio: continuous RTSP capture and
get_last_frame (640×360 PNG as base64).
"""

from __future__ import annotations

import argparse
import base64
import json
import os
import re
import socket
import sys
import threading
import time
from typing import Any

# Loaded lazily in the capture thread so the main thread can answer MCP
# initialize immediately (PyGI + Gst.init can take many seconds).
Gst: Any = None
GLib: Any = None
_gstreamer_ready = False


def _ensure_gstreamer_loaded() -> None:
    global Gst, GLib, _gstreamer_ready
    if _gstreamer_ready:
        return
    import gi

    gi.require_version("Gst", "1.0")
    from gi.repository import Gst as _Gst, GLib as _GLib  # noqa: E402

    Gst, GLib = _Gst, _GLib
    Gst.init(None)
    _gstreamer_ready = True


DEFAULT_RTSP_URL = os.environ.get("RTSP_URL", "rtsp://127.0.0.1:1234/hdmi")
DEFAULT_CONNECT_RETRIES = int(os.environ.get("CONNECT_RETRIES", "10"))
DEFAULT_CONNECT_DELAY = float(os.environ.get("CONNECT_DELAY_SECONDS", "1"))
# Advertised when client omits protocolVersion; echo client's version when given.
MCP_PROTOCOL_VERSION = "2024-11-05"


def parse_rtsp_host_port(url: str) -> tuple[str, int] | None:
    m = re.match(r"^rtsp://([^/:]+)(?::([0-9]+))?(/.*)?$", url)
    if not m:
        return None
    host = m.group(1)
    port = int(m.group(2) or "554")
    return host, port


def tcp_port_open(host: str, port: int, timeout: float = 1.0) -> bool:
    try:
        with socket.create_connection((host, port), timeout=timeout):
            return True
    except OSError:
        return False


def wait_for_tcp_ok(url: str, retries: int, delay: float, debug: bool) -> bool:
    parsed = parse_rtsp_host_port(url)
    if not parsed:
        print("[ERR] Invalid RTSP URL (expected rtsp://HOST:PORT/PATH)", file=sys.stderr)
        return False
    host, port = parsed
    for attempt in range(1, retries + 1):
        if tcp_port_open(host, port):
            if debug:
                print(f"[INFO] TCP port open: {host}:{port}", file=sys.stderr)
            return True
        if attempt >= retries:
            print(
                f"[ERR] RTSP server not listening on {host}:{port}",
                file=sys.stderr,
            )
            return False
        if debug:
            print(
                f"[INFO] Port not open yet; retry {attempt}/{retries}...",
                file=sys.stderr,
            )
        time.sleep(delay)
    return False


def run_rtsp_test(url: str, debug: bool) -> bool:
    pipeline = Gst.Pipeline.new("rtsp-test")
    src = Gst.ElementFactory.make("rtspsrc", "src")
    sink = Gst.ElementFactory.make("fakesink", "sink")
    if not src or not sink:
        print("[ERR] Failed to create test elements", file=sys.stderr)
        return False

    src.set_property("location", url)
    src.set_property("protocols", 0x4)
    src.set_property("latency", 0)

    def select_stream(_src, stream_id, caps):
        media = None
        try:
            if caps and caps.get_size() > 0:
                s = caps.get_structure(0)
                media = s.get_string("media")
        except Exception:
            media = None
        accept = media == "video"
        if debug:
            print(
                f"[INFO] select-stream stream={stream_id} media={media!r} -> "
                f"{'ACCEPT' if accept else 'REJECT'}",
                file=sys.stderr,
            )
        return accept

    src.connect("select-stream", select_stream)
    pipeline.add(src)
    pipeline.add(sink)

    loop = GLib.MainLoop()
    bus = pipeline.get_bus()
    bus.add_signal_watch()
    ok = {"v": False}

    def on_message(_bus, msg):
        t = msg.type
        if t == Gst.MessageType.ERROR:
            err, dbg = msg.parse_error()
            print(f"[ERR] {err.message}", file=sys.stderr)
            if debug and dbg:
                print(f"[ERR] debug: {dbg}", file=sys.stderr)
            loop.quit()
        elif t == Gst.MessageType.STATE_CHANGED and msg.src == pipeline:
            _old, new, _pending = msg.parse_state_changed()
            if new == Gst.State.PLAYING:
                ok["v"] = True
                loop.quit()
        return True

    bus.connect("message", on_message)

    def on_pad_added(_src, pad):
        sp = sink.get_static_pad("sink")
        if sp and not sp.is_linked():
            pad.link(sp)

    src.connect("pad-added", on_pad_added)
    pipeline.set_state(Gst.State.PLAYING)
    GLib.timeout_add_seconds(5, lambda: (loop.quit(), False)[1])
    loop.run()
    pipeline.set_state(Gst.State.NULL)
    return ok["v"]


def wait_for_rtsp_ok(url: str, retries: int, delay: float, debug: bool) -> bool:
    for attempt in range(1, retries + 1):
        if run_rtsp_test(url, debug):
            return True
        if attempt >= retries:
            print(f"[ERR] Failed to connect to RTSP: {url}", file=sys.stderr)
            if not debug:
                print("[ERR] Re-run with --debug for details.", file=sys.stderr)
            return False
        if debug:
            print(
                f"[INFO] RTSP test failed; retry {attempt}/{retries}...",
                file=sys.stderr,
            )
        time.sleep(delay)
    return False


def _build_capture_branch(
    pipeline: Gst.Pipeline,
    src: Gst.Element,
    url: str,
    debug: bool,
    on_sample,
    loop: GLib.MainLoop,
    state_ok: dict,
) -> bool:
    """rtspsrc -> queue -> decodebin -> ... -> appsink (640×360 PNG)."""
    global _capture_appsink

    src.set_property("location", url)
    src.set_property("protocols", 0x4)
    try:
        src.set_property("latency", 100)
        src.set_property("drop-on-latency", True)
    except (TypeError, ValueError, AttributeError):
        try:
            src.set_property("latency", 0)
        except (TypeError, ValueError, AttributeError):
            pass

    def select_stream(_s, stream_id, caps):
        media = None
        try:
            if caps and caps.get_size() > 0:
                st = caps.get_structure(0)
                media = st.get_string("media")
        except Exception:
            media = None
        accept = media == "video"
        if debug:
            print(
                f"[INFO] select-stream stream={stream_id} media={media!r} -> "
                f"{'ACCEPT' if accept else 'REJECT'}",
                file=sys.stderr,
            )
        return accept

    src.connect("select-stream", select_stream)

    queue = Gst.ElementFactory.make("queue", "queue")
    decode = Gst.ElementFactory.make("decodebin", "decode")
    post_decode = Gst.ElementFactory.make("queue", "post_decode_queue")
    videoconvert = Gst.ElementFactory.make("videoconvert", "videoconvert")
    videoscale = Gst.ElementFactory.make("videoscale", "videoscale")
    capsfilter = Gst.ElementFactory.make("capsfilter", "capsfilter")
    pre_png = Gst.ElementFactory.make("queue", "pre_png_queue")
    pngenc = Gst.ElementFactory.make("pngenc", "pngenc")
    sink = Gst.ElementFactory.make("appsink", "sink")

    if not all(
        [
            queue,
            decode,
            post_decode,
            videoconvert,
            videoscale,
            capsfilter,
            pre_png,
            pngenc,
            sink,
        ]
    ):
        print("[ERR] Failed to create pipeline elements", file=sys.stderr)
        state_ok["ok"] = False
        return False

    def _configure_live_queue(q: Gst.Element) -> None:
        q.set_property("max-size-buffers", 1)
        q.set_property("max-size-time", 0)
        q.set_property("max-size-bytes", 0)
        try:
            q.set_property("leaky", Gst.QueueLeaky.DOWNSTREAM)
        except (TypeError, AttributeError):
            q.set_property("leaky", 2)

    # Drop backlog so appsink sees recent frames, not seconds-old RTSP buffer.
    _configure_live_queue(queue)
    _configure_live_queue(post_decode)
    _configure_live_queue(pre_png)

    capsfilter.set_property(
        "caps",
        Gst.Caps.from_string(
            "video/x-raw,format=RGBA,width=640,height=360,pixel-aspect-ratio=1/1"
        ),
    )
    sink.set_property("emit-signals", True)
    sink.set_property("sync", False)
    sink.set_property("max-buffers", 1)
    sink.set_property("drop", True)

    for el in (
        queue,
        decode,
        post_decode,
        videoconvert,
        videoscale,
        capsfilter,
        pre_png,
        pngenc,
        sink,
    ):
        pipeline.add(el)

    if not queue.link(decode):
        print("[ERR] Failed to link queue->decodebin", file=sys.stderr)
        state_ok["ok"] = False
        return False

    if not post_decode.link(videoconvert):
        print("[ERR] Failed to link post_decode->videoconvert", file=sys.stderr)
        state_ok["ok"] = False
        return False

    if not videoconvert.link(videoscale):
        print("[ERR] Failed to link videoconvert->videoscale", file=sys.stderr)
        state_ok["ok"] = False
        return False
    if not videoscale.link(capsfilter):
        print("[ERR] Failed to link videoscale->capsfilter", file=sys.stderr)
        state_ok["ok"] = False
        return False
    if not capsfilter.link(pre_png):
        print("[ERR] Failed to link capsfilter->pre_png", file=sys.stderr)
        state_ok["ok"] = False
        return False
    if not pre_png.link(pngenc) or not pngenc.link(sink):
        print("[ERR] Failed to link pre_png/pngenc/appsink", file=sys.stderr)
        state_ok["ok"] = False
        return False

    def on_src_pad_added(_src_el, pad):
        sp = queue.get_static_pad("sink")
        if sp and not sp.is_linked():
            pad.link(sp)

    def on_decode_pad_added(_dec, pad):
        caps = pad.get_current_caps() or pad.query_caps(None)
        if not caps or caps.get_size() == 0:
            return
        st = caps.get_structure(0)
        if not st.get_name().startswith("video/"):
            return
        sp = post_decode.get_static_pad("sink")
        if sp and not sp.is_linked():
            pad.link(sp)

    src.connect("pad-added", on_src_pad_added)
    decode.connect("pad-added", on_decode_pad_added)

    def on_new_sample(appsink):
        sample = appsink.emit("pull-sample")
        if not sample:
            return Gst.FlowReturn.ERROR
        buf = sample.get_buffer()
        ok, mapinfo = buf.map(Gst.MapFlags.READ)
        if not ok:
            return Gst.FlowReturn.ERROR
        try:
            on_sample(bytes(mapinfo.data))
        finally:
            buf.unmap(mapinfo)
        return Gst.FlowReturn.OK

    sink.connect("new-sample", on_new_sample)
    _capture_appsink = sink
    return True


_last_frame_lock = threading.Lock()
_last_png: bytes | None = None
_capture_appsink: Any = None


def _sample_to_png_bytes(sample) -> bytes | None:
    if not sample:
        return None
    buf = sample.get_buffer()
    ok, mapinfo = buf.map(Gst.MapFlags.READ)
    if not ok:
        return None
    try:
        return bytes(mapinfo.data)
    finally:
        buf.unmap(mapinfo)


def _pull_fresh_png_from_appsink() -> bytes | None:
    """Drain pending buffers and/or wait briefly so get_last_frame is current.

    The signal-driven path can lag; pulling on demand flushes appsink and
    waits up to ~300ms for the next encoded frame.
    """
    global _last_png
    if not _gstreamer_ready:
        return None
    sink = _capture_appsink
    if sink is None:
        return None

    last: bytes | None = None
    while True:
        sample = sink.emit("try-pull-sample", 0)
        if not sample:
            break
        b = _sample_to_png_bytes(sample)
        if b is not None:
            last = b

    if last is None:
        sample = sink.emit("try-pull-sample", 500 * Gst.MSECOND)
        if sample:
            b = _sample_to_png_bytes(sample)
            if b is not None:
                last = b

    if last is not None:
        with _last_frame_lock:
            _last_png = last
        return last
    return None


def _read_mcp_message() -> tuple[dict, str] | None:
    """Read one JSON-RPC message. Returns (message, 'ndjson'|'cl') or None on EOF.

    MCP 2025-03-26 stdio: one JSON object per line (NDJSON). Older clients use
    Content-Length framing. Cursor uses NDJSON.
    """
    while True:
        line = sys.stdin.buffer.readline()
        if not line:
            return None
        raw = line.strip()
        if not raw:
            continue
        raw = raw.lstrip(b"\xef\xbb\xbf")

        if raw.startswith(b"{"):
            try:
                return json.loads(raw.decode("utf-8")), "ndjson"
            except (json.JSONDecodeError, UnicodeDecodeError) as e:
                print(f"[ERR] MCP invalid NDJSON line: {e}", file=sys.stderr)
                continue

        if raw.lower().startswith(b"content-length:"):
            headers: dict[bytes, bytes] = {}
            name, _, value = raw.partition(b":")
            headers[name.strip().lower()] = value.strip()
            while True:
                line2 = sys.stdin.buffer.readline()
                if not line2:
                    return None
                if line2 in (b"\r\n", b"\n") or not line2.strip():
                    break
                if b":" not in line2:
                    continue
                n2, _, v2 = line2.partition(b":")
                headers[n2.strip().lower()] = v2.strip()
            cl = headers.get(b"content-length")
            if cl is None:
                print("[ERR] MCP Content-Length block without length", file=sys.stderr)
                continue
            n = int(cl)
            body = sys.stdin.buffer.read(n)
            if len(body) != n:
                print("[ERR] MCP short body read", file=sys.stderr)
                return None
            try:
                return json.loads(body.decode("utf-8")), "cl"
            except (json.JSONDecodeError, UnicodeDecodeError) as e:
                print(f"[ERR] MCP invalid JSON body: {e}", file=sys.stderr)
                continue

        print(f"[ERR] MCP unrecognised line: {raw[:100]!r}", file=sys.stderr)
        continue


def _write_mcp_message(obj: dict, fmt: str) -> bool:
    try:
        data = json.dumps(obj, separators=(",", ":"), ensure_ascii=False).encode(
            "utf-8"
        )
        if fmt == "ndjson":
            sys.stdout.buffer.write(data + b"\n")
        else:
            sys.stdout.buffer.write(
                f"Content-Length: {len(data)}\r\n\r\n".encode("ascii") + data
            )
        sys.stdout.buffer.flush()
    except BrokenPipeError:
        return False
    return True


def _mcp_tools_list() -> dict:
    return {
        "tools": [
            {
                "name": "get_last_frame",
                "description": (
                    "Return the most recently captured RTSP video frame as a "
                    "640x360 PNG (base64)."
                ),
                "inputSchema": {
                    "type": "object",
                    "properties": {},
                    "additionalProperties": False,
                },
            }
        ]
    }


def _mcp_tools_call(name: str, _arguments: dict | None) -> dict:
    if name != "get_last_frame":
        return {
            "isError": True,
            "content": [
                {
                    "type": "text",
                    "text": f"Unknown tool: {name}",
                }
            ],
        }
    fresh = _pull_fresh_png_from_appsink()
    with _last_frame_lock:
        png = fresh if fresh is not None else _last_png
    if not png:
        return {
            "isError": True,
            "content": [
                {
                    "type": "text",
                    "text": "No frame available yet (stream still starting or error).",
                }
            ],
        }
    b64 = base64.b64encode(png).decode("ascii")
    return {
        "content": [
            {
                "type": "text",
                "text": "Last captured frame (640x360 PNG).",
            },
            {
                "type": "image",
                "mimeType": "image/png",
                "data": b64,
            },
        ]
    }


def run_mcp_server(
    url: str,
    debug: bool,
    connect_retries: int,
    connect_delay: float,
) -> None:
    """MCP JSON-RPC on stdin/stdout immediately; RTSP + GStreamer in background."""

    def capture_thread_main():
        _ensure_gstreamer_loaded()
        if not wait_for_tcp_ok(url, connect_retries, connect_delay, debug):
            print(
                "[ERR] Capture thread: TCP preflight failed; "
                "get_last_frame will stay empty until RTSP is up — restart MCP or "
                "start the server.",
                file=sys.stderr,
            )
            return
        if not wait_for_rtsp_ok(url, connect_retries, connect_delay, debug):
            print(
                "[ERR] Capture thread: RTSP preflight failed; "
                "get_last_frame will stay empty.",
                file=sys.stderr,
            )
            return

        pipeline = Gst.Pipeline.new("rtsp-mcp")
        src = Gst.ElementFactory.make("rtspsrc", "src")
        if not src:
            print("[ERR] Failed to create rtspsrc", file=sys.stderr)
            return
        pipeline.add(src)
        loop = GLib.MainLoop()
        bus = pipeline.get_bus()
        bus.add_signal_watch()

        def on_message(_bus, msg):
            if msg.type == Gst.MessageType.ERROR:
                err, dbg = msg.parse_error()
                print(f"[ERR] {err.message}", file=sys.stderr)
                if debug and dbg:
                    print(f"[ERR] debug: {dbg}", file=sys.stderr)
            return True

        bus.connect("message", on_message)
        state_ok = {"ok": True}

        def on_sample(png_bytes: bytes):
            global _last_png
            with _last_frame_lock:
                _last_png = png_bytes

        if not _build_capture_branch(
            pipeline,
            src,
            url,
            debug,
            on_sample,
            loop,
            state_ok,
        ):
            return

        if debug:
            print("[INFO] RTSP capture pipeline PLAYING", file=sys.stderr)
        pipeline.set_state(Gst.State.PLAYING)
        loop.run()
        pipeline.set_state(Gst.State.NULL)

    threading.Thread(
        target=capture_thread_main,
        name="capture",
        daemon=True,
    ).start()

    while True:
        got = _read_mcp_message()
        if got is None:
            break
        msg, wire_fmt = got
        if msg.get("jsonrpc") != "2.0":
            continue
        msg_id = msg.get("id")
        method = msg.get("method")
        params = msg.get("params") or {}

        if method == "initialize":
            p = params if isinstance(params, dict) else {}
            req_pv = p.get("protocolVersion")
            if isinstance(req_pv, str) and req_pv.strip():
                negotiated = req_pv.strip()
            else:
                negotiated = MCP_PROTOCOL_VERSION
            if not _write_mcp_message(
                {
                    "jsonrpc": "2.0",
                    "id": msg_id,
                    "result": {
                        "protocolVersion": negotiated,
                        "capabilities": {"tools": {}},
                        "serverInfo": {
                            "name": "hdmi-usb-screenshot-mcp",
                            "version": "1.0.0",
                        },
                    },
                },
                wire_fmt,
            ):
                break
            continue

        if method == "notifications/initialized":
            continue

        if method == "ping" and msg_id is not None:
            if not _write_mcp_message(
                {"jsonrpc": "2.0", "id": msg_id, "result": {}},
                wire_fmt,
            ):
                break
            continue

        if msg_id is None:
            continue

        if method == "tools/list":
            if not _write_mcp_message(
                {
                    "jsonrpc": "2.0",
                    "id": msg_id,
                    "result": _mcp_tools_list(),
                },
                wire_fmt,
            ):
                break
            continue

        if method == "tools/call":
            name = params.get("name", "")
            args = params.get("arguments")
            result = _mcp_tools_call(name, args if isinstance(args, dict) else {})
            if not _write_mcp_message(
                {"jsonrpc": "2.0", "id": msg_id, "result": result},
                wire_fmt,
            ):
                break
            continue

        if not _write_mcp_message(
            {
                "jsonrpc": "2.0",
                "id": msg_id,
                "error": {
                    "code": -32601,
                    "message": f"Method not found: {method}",
                },
            },
            wire_fmt,
        ):
            break


def main() -> int:
    if hasattr(sys.stdout, "reconfigure"):
        try:
            sys.stdout.reconfigure(line_buffering=True)
        except (OSError, ValueError):
            pass

    p = argparse.ArgumentParser(
        description=(
            "MCP server on stdio: RTSP capture and tool get_last_frame "
            "(640×360 PNG, base64)."
        ),
    )
    p.add_argument("-d", "--debug", action="store_true", help="Verbose stderr logs")
    p.add_argument(
        "-u",
        "--url",
        default=DEFAULT_RTSP_URL,
        help=f"RTSP URL (default: {DEFAULT_RTSP_URL})",
    )
    p.add_argument(
        "--connect-retries",
        type=int,
        default=DEFAULT_CONNECT_RETRIES,
        help="TCP/RTSP preflight retries in background (MCP answers immediately)",
    )
    p.add_argument(
        "--connect-delay",
        type=float,
        default=DEFAULT_CONNECT_DELAY,
        help="Seconds between preflight retries",
    )
    args = p.parse_args()

    run_mcp_server(
        args.url,
        args.debug,
        args.connect_retries,
        args.connect_delay,
    )
    return 0


if __name__ == "__main__":
    sys.exit(main())
