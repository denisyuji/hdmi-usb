#!/usr/bin/env python3
"""
hdmi-usb-screenshot-mcp — MCP server on stdio exposing get_last_frame.
"""

from __future__ import annotations

import argparse
import base64
import glob
import json
import os
import subprocess
import sys
import tempfile

DEFAULT_RTSP_URL = os.environ.get("RTSP_URL", "rtsp://127.0.0.1:1234/hdmi")
MCP_PROTOCOL_VERSION = "2024-11-05"
_capture_url = DEFAULT_RTSP_URL
_capture_debug = False


def _capture_png_via_gst_launch(url: str, debug: bool) -> bytes | None:
    """Grab a current frame using a short uridecodebin-based gst-launch burst."""
    tmp_dir = tempfile.mkdtemp(prefix="hdmi-usb-screenshot-mcp-")
    pattern = os.path.join(tmp_dir, "frame_%05d.png")

    cmd = [
        "timeout",
        "10",
        "gst-launch-1.0",
        "-q",
        "uridecodebin",
        f"uri={url}",
        "source::protocols=tcp",
        "source::latency=100",
        "name=dec",
        "dec.",
        "!",
        "queue",
        "!",
        "videoconvert",
        "!",
        "videoscale",
        "!",
        "video/x-raw,format=RGBA,width=640,height=360,pixel-aspect-ratio=1/1",
        "!",
        "pngenc",
        "!",
        "multifilesink",
        f"location={pattern}",
        "max-files=50",
    ]
    try:
        proc = subprocess.run(
            cmd,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            timeout=12,
            check=False,
        )
    except (OSError, subprocess.TimeoutExpired) as e:
        if debug:
            print(f"[ERR] gst-launch capture failed: {e}", file=sys.stderr)
        return None

    if proc.returncode not in (0, 124):
        if debug and proc.stderr:
            print(proc.stderr.decode("utf-8", errors="replace"), file=sys.stderr)
        return None

    try:
        frames = sorted(glob.glob(os.path.join(tmp_dir, "frame_*.png")))
        if not frames:
            if debug and proc.stderr:
                print(
                    "[ERR] gst-launch produced no PNG frames\n"
                    + proc.stderr.decode("utf-8", errors="replace"),
                    file=sys.stderr,
                )
            return None
        data = open(frames[-1], "rb").read()
    except OSError as e:
        if debug:
            print(f"[ERR] Failed to read temporary PNG: {e}", file=sys.stderr)
        return None
    finally:
        try:
            for path in glob.glob(os.path.join(tmp_dir, "*")):
                os.unlink(path)
            os.rmdir(tmp_dir)
        except OSError:
            pass

    if not data.startswith(b"\x89PNG\r\n\x1a\n"):
        if debug:
            print("[ERR] gst-launch capture did not return PNG data", file=sys.stderr)
        return None
    return data


def _read_mcp_message() -> tuple[dict, str] | None:
    """Read one JSON-RPC message. Returns (message, 'ndjson'|'cl') or None on EOF.

    MCP 2025-03-26 stdio: one JSON object per line (NDJSON). Older clients use
    Content-Length framing. Cursor uses NDJSON.
    """
    while True:
        line = sys.stdin.buffer.readline()
        if not line:
            return None
        raw = line.strip()
        if not raw:
            continue
        raw = raw.lstrip(b"\xef\xbb\xbf")

        if raw.startswith(b"{"):
            try:
                return json.loads(raw.decode("utf-8")), "ndjson"
            except (json.JSONDecodeError, UnicodeDecodeError) as e:
                print(f"[ERR] MCP invalid NDJSON line: {e}", file=sys.stderr)
                continue

        if raw.lower().startswith(b"content-length:"):
            headers: dict[bytes, bytes] = {}
            name, _, value = raw.partition(b":")
            headers[name.strip().lower()] = value.strip()
            while True:
                line2 = sys.stdin.buffer.readline()
                if not line2:
                    return None
                if line2 in (b"\r\n", b"\n") or not line2.strip():
                    break
                if b":" not in line2:
                    continue
                n2, _, v2 = line2.partition(b":")
                headers[n2.strip().lower()] = v2.strip()
            cl = headers.get(b"content-length")
            if cl is None:
                print("[ERR] MCP Content-Length block without length", file=sys.stderr)
                continue
            n = int(cl)
            body = sys.stdin.buffer.read(n)
            if len(body) != n:
                print("[ERR] MCP short body read", file=sys.stderr)
                return None
            try:
                return json.loads(body.decode("utf-8")), "cl"
            except (json.JSONDecodeError, UnicodeDecodeError) as e:
                print(f"[ERR] MCP invalid JSON body: {e}", file=sys.stderr)
                continue

        print(f"[ERR] MCP unrecognised line: {raw[:100]!r}", file=sys.stderr)
        continue


def _write_mcp_message(obj: dict, fmt: str) -> bool:
    try:
        data = json.dumps(obj, separators=(",", ":"), ensure_ascii=False).encode(
            "utf-8"
        )
        if fmt == "ndjson":
            sys.stdout.buffer.write(data + b"\n")
        else:
            sys.stdout.buffer.write(
                f"Content-Length: {len(data)}\r\n\r\n".encode("ascii") + data
            )
        sys.stdout.buffer.flush()
    except BrokenPipeError:
        return False
    return True


def _mcp_tools_list() -> dict:
    return {
        "tools": [
            {
                "name": "get_last_frame",
                "description": (
                    "Return the most recently captured RTSP video frame as a "
                    "640x360 PNG (base64)."
                ),
                "inputSchema": {
                    "type": "object",
                    "properties": {},
                    "additionalProperties": False,
                },
            }
        ]
    }


def _mcp_tools_call(name: str, _arguments: dict | None) -> dict:
    if name != "get_last_frame":
        return {
            "isError": True,
            "content": [
                {
                    "type": "text",
                    "text": f"Unknown tool: {name}",
                }
            ],
        }
    png = _capture_png_via_gst_launch(_capture_url, _capture_debug)
    if not png:
        return {
            "isError": True,
            "content": [
                {
                    "type": "text",
                    "text": "No frame available yet (stream still starting or error).",
                }
            ],
        }
    b64 = base64.b64encode(png).decode("ascii")
    return {
        "content": [
            {
                "type": "text",
                "text": "Last captured frame (640x360 PNG).",
            },
            {
                "type": "image",
                "mimeType": "image/png",
                "data": b64,
            },
        ]
    }


def run_mcp_server(url: str, debug: bool) -> None:
    """MCP JSON-RPC on stdin/stdout immediately."""
    global _capture_url, _capture_debug
    _capture_url = url
    _capture_debug = debug

    while True:
        got = _read_mcp_message()
        if got is None:
            break
        msg, wire_fmt = got
        if msg.get("jsonrpc") != "2.0":
            continue
        msg_id = msg.get("id")
        method = msg.get("method")
        params = msg.get("params") or {}

        if method == "initialize":
            p = params if isinstance(params, dict) else {}
            req_pv = p.get("protocolVersion")
            if isinstance(req_pv, str) and req_pv.strip():
                negotiated = req_pv.strip()
            else:
                negotiated = MCP_PROTOCOL_VERSION
            if not _write_mcp_message(
                {
                    "jsonrpc": "2.0",
                    "id": msg_id,
                    "result": {
                        "protocolVersion": negotiated,
                        "capabilities": {"tools": {}},
                        "serverInfo": {
                            "name": "hdmi-usb-screenshot-mcp",
                            "version": "1.0.0",
                        },
                    },
                },
                wire_fmt,
            ):
                break
            continue

        if method == "notifications/initialized":
            continue

        if method == "ping" and msg_id is not None:
            if not _write_mcp_message(
                {"jsonrpc": "2.0", "id": msg_id, "result": {}},
                wire_fmt,
            ):
                break
            continue

        if msg_id is None:
            continue

        if method == "tools/list":
            if not _write_mcp_message(
                {
                    "jsonrpc": "2.0",
                    "id": msg_id,
                    "result": _mcp_tools_list(),
                },
                wire_fmt,
            ):
                break
            continue

        if method == "tools/call":
            name = params.get("name", "")
            args = params.get("arguments")
            result = _mcp_tools_call(name, args if isinstance(args, dict) else {})
            if not _write_mcp_message(
                {"jsonrpc": "2.0", "id": msg_id, "result": result},
                wire_fmt,
            ):
                break
            continue

        if not _write_mcp_message(
            {
                "jsonrpc": "2.0",
                "id": msg_id,
                "error": {
                    "code": -32601,
                    "message": f"Method not found: {method}",
                },
            },
            wire_fmt,
        ):
            break


def main() -> int:
    if hasattr(sys.stdout, "reconfigure"):
        try:
            sys.stdout.reconfigure(line_buffering=True)
        except (OSError, ValueError):
            pass

    p = argparse.ArgumentParser(
        description=(
            "MCP server on stdio: RTSP capture and tool get_last_frame "
            "(640×360 PNG, base64)."
        ),
    )
    p.add_argument("-d", "--debug", action="store_true", help="Verbose stderr logs")
    p.add_argument(
        "-u",
        "--url",
        default=DEFAULT_RTSP_URL,
        help=f"RTSP URL (default: {DEFAULT_RTSP_URL})",
    )
    args = p.parse_args()

    run_mcp_server(args.url, args.debug)
    return 0


if __name__ == "__main__":
    sys.exit(main())
